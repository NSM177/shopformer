FROM python:3.11-slim

WORKDIR /app

# PYTHONUNBUFFERED=1 để log in trực tiếp ra docker logs mà không bị nghẽn đệm
# PYTHONDONTWRITEBYTECODE=1 để không tạo file .pyc rác trong container
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Cài libglib2.0-0 và curl (dùng cho healthcheck và OpenCV)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt các thư viện Python với uvicorn[standard] để hiệu năng cao hơn
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    paho-mqtt \
    pyyaml \
    numpy \
    opencv-python-headless \
    pydantic

# Tạo sẵn thư mục lưu dữ liệu và clips
RUN mkdir -p /app/data/clips

# Copy mã nguồn dashboard và cấu hình
COPY configs/ /app/configs/
COPY src/__init__.py /app/src/__init__.py
COPY src/alerting.py /app/src/alerting.py
COPY src/mqtt_pub.py /app/src/mqtt_pub.py
COPY src/dashboard/ /app/src/dashboard/

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

CMD ["python", "-m", "src.dashboard.app", "--config", "configs/default.yaml", "--host", "0.0.0.0", "--port", "8000"]
